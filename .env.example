# Copy to .env and fill in. .env is gitignored and must never be committed.

# Provider-neutral OpenAI-compatible LLM configuration. Change these four values to
# switch between ModelScope, Alibaba Cloud Model Studio, or another compatible provider.
PHYSEARTH_LLM_API_KEY=
PHYSEARTH_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
PHYSEARTH_LLM_MODEL=qwen-plus
PHYSEARTH_LLM_MODELS=qwen-plus,qwen-turbo,qwen-max

# ModelScope access token. Since the git token was merged into the SDK token,
# this single value is used both for API-Inference calls and for pushing to the
# Studio repository.
MODELSCOPE_TOKEN=

# Studio namespace: the segment after /studios/ in the Studio URL.
MODELSCOPE_NAMESPACE=

# Legacy ModelScope variables. Existing deployments continue to use these when the
# provider-neutral variables above are empty.
MODELSCOPE_API_BASE=https://api-inference.modelscope.cn/v1
MODELSCOPE_MODEL=Qwen/Qwen3.5-122B-A10B
